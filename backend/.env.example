# Salin file ini menjadi .env lalu isi sesuai lingkungan (lokal atau VM)

PORT=4000

# Koneksi ke MySQL/MariaDB (mis. DB VM di Proxmox)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=desa_app
DB_PASSWORD=ganti_dengan_password_aman
DB_NAME=website_desa

# Secret untuk menandatangani token JWT admin - ganti dengan string acak panjang
JWT_SECRET=ganti_dengan_secret_acak_panjang
JWT_EXPIRES_IN=8h

# Origin frontend yang diizinkan mengakses API (Vite dev server / domain produksi)
CORS_ORIGIN=http://localhost:5173
