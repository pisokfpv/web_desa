# .env untuk backend di VM RMD (production)
# Salin isi ini ke .env yang sudah ada di /var/www/web-desa/web_desa/backend/

PORT=4000

# Database di VM terpisah
DB_HOST=192.168.100.218
DB_PORT=3306
DB_USER=indratch
DB_PASSWORD=isi_sesuai_password_asli
DB_NAME=website_desa

JWT_SECRET=ganti_dengan_secret_acak_panjang_dan_rahasia
JWT_EXPIRES_IN=8h

# Karena Nginx me-reverse-proxy /api ke backend ini di domain yang sama,
# origin browser yang sebenarnya adalah domain publik di bawah ini.
CORS_ORIGIN=https://tombasianatassatu.holticare.online
